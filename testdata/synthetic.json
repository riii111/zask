{
  "project": {
    "name": "demo",
    "root": "/tmp/zask-demo",
    "session_name": "demo"
  },
  "docker": {
    "compose": "infra/compose.yaml",
    "wait_timeout_seconds": 5
  },
  "start_profiles": {
    "core": {
      "profile": "core",
      "label": "core services",
      "group_overrides": {
        "backend": "core-backend"
      }
    }
  },
  "startup_order": [
    {
      "name": "Docker",
      "docker": true
    },
    {
      "name": "Backend",
      "group": "backend",
      "wait_ports": [
        18080
      ]
    },
    {
      "name": "Frontend",
      "group": "frontend"
    }
  ],
  "group_aliases": {
    "backend": [
      "api",
      "worker"
    ],
    "core-backend": [
      "api"
    ],
    "frontend": [
      "web"
    ]
  },
  "groups": [
    {
      "name": "backend",
      "services": [
        {
          "name": "api",
          "dir": "backend",
          "command": "serve",
          "port": 18080
        },
        {
          "name": "worker",
          "dir": "backend",
          "command": "work"
        }
      ]
    },
    {
      "name": "frontend",
      "services": [
        {
          "name": "web",
          "dir": "frontend",
          "runtime": "npm",
          "command": "run dev",
          "port": 15173
        }
      ]
    }
  ]
}
